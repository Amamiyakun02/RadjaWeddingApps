# ========================================================
# Radja Wedding Management System - Environment Template
# ========================================================

APP_NAME="Radja Wedding Management"
APP_ENV="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Database (Default SQLite or CockroachDB/Postgres)
DATABASE_URL="sqlite:///./radja_wedding.db"

# JWT & Security
SECRET_KEY="radja-wedding-super-secret-key-signature-2026-production-ready"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Admin Seed
ADMIN_DEFAULT_EMAIL="admin@radja.com"
ADMIN_DEFAULT_PASSWORD="admin123"
STAFF_DEFAULT_EMAIL="staf@radja.com"
STAFF_DEFAULT_PASSWORD="staf123"

# Google Auth & WhatsApp Simulation
GOOGLE_CLIENT_ID="mock-google-client-id.apps.googleusercontent.com"
WA_GATEWAY_MOCK=true
DEFAULT_TEST_OTP="123456"

# Gemini AI (Optional - will fallback gracefully to built-in simulation)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
ENABLE_AI_SIMULATION=true

# Upload
UPLOAD_DIR="./uploads"
BASE_URL="http://localhost:8000"
